{
  "name": "mobx-spine",
  "version": "0.28.6",
  "license": "ISC",
  "author": "Kees Kluskens <kees@webduck.nl>",
  "description": "MobX with support for models, relations and an API.",
  "module": "dist/mobx-spine.es.js",
  "main": "dist/mobx-spine.cjs.js",
  "repository": {
    "type": "git",
    "url": "git://github.com/CodeYellowBV/mobx-spine.git"
  },
  "scripts": {
    "test": "jest",
    "test-dev": "jest --watch",
    "test-coverage": "jest --coverage",
    "lint": "eslint src",
    "preversion": "pnpm run -s lint && pnpm test && pnpm run -s build",
    "version": "git add -A dist",
    "build": "rm -f dist/** && BABEL_ENV=production node build.js",
    "ci": "pnpm run -s lint && pnpm run -s test-coverage"
  },
  "packageManager": "pnpm@10.18.2",
  "pnpm": {
    "ignoredBuiltDependencies": [
      "core-js"
    ],
    "overrides": {
      "ajv@6": "6.15.0",
      "brace-expansion@1": "1.1.22",
      "cross-spawn@6": "6.0.6",
      "diff@3": "3.5.1",
      "form-data@2": "2.5.6",
      "handlebars@4": "4.7.10",
      "js-yaml@3": "3.15.2",
      "minimatch@3": "3.1.5",
      "semver@5": "5.7.3",
      "semver@6": "6.3.2",
      "word-wrap@1": "1.2.5",
      "ws@5": "5.2.8"
    }
  },
  "dependencies": {
    "axios": "0.35.0"
  },
  "engines": {
    "node": ">=4"
  },
  "files": [
    "dist/"
  ],
  "devDependencies": {
    "axios-mock-adapter": "1.21.3",
    "babel-core": "6.26.3",
    "babel-jest": "23.6.0",
    "babel-plugin-external-helpers": "6.22.0",
    "babel-plugin-transform-decorators-legacy": "1.3.5",
    "babel-plugin-transform-es2015-modules-commonjs": "6.26.2",
    "babel-preset-es2015": "6.24.1",
    "babel-preset-stage-2": "6.24.1",
    "eslint": "5.16.0",
    "eslint-config-codeyellow": "4.1.5",
    "jest": "23.6.0",
    "lodash": "4.18.1",
    "luxon": "3.3.0",
    "mobx": "5.15.7",
    "moment": "2.31.0",
    "rollup": "1.32.1",
    "rollup-plugin-babel": "3.0.7"
  },
  "peerDependencies": {
    "lodash": "^4.17.21",
    "luxon": "^1.28.1 || ^2.5.2 || ^3.2.1",
    "mobx": "^4.15.7 || ^5.15.7",
    "moment": "^2.29.4"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "roots": [
      "./src"
    ],
    "modulePaths": [
      "./src"
    ],
    "testPathIgnorePatterns": [
      "/fixtures/"
    ]
  }
}
